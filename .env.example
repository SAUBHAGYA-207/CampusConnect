# ==============================================================
# CampusConnect Deployment & Environment Configuration (.env)
# ==============================================================

PORT=3000
NODE_ENV=production
SESSION_SECRET=generate_a_secure_random_string_here_min_32_characters
APP_BASE_URL=https://your-domain.com

# ==============================================================
# REAL EMAIL DELIVERY (OTP, Notifications & Moderation Notices)
# ==============================================================
# CHOOSE EITHER OPTION A (Gmail) OR OPTION B (Custom SMTP Provider)

# --- OPTION A: GMAIL (Quickest & Most Reliable for Personal / Campus Projects) ---
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password" (16 letters): https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and the 16-letter App Password below:
SMTP_SERVICE=gmail
SMTP_USER=your_campus_or_personal_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="CampusConnect" <your_campus_or_personal_email@gmail.com>

# --- OPTION B: BREVO HTTP API (RECOMMENDED FOR RENDER & CLOUD DEPLOYMENTS) ---
# Sends to ANY student/user email without requiring you to own a custom domain.
# 300 free emails/day. Uses HTTPS Port 443 which is NEVER blocked by Render firewall.
# 1. Sign up at https://brevo.com
# 2. Add your sender email (e.g. campusconnect216@gmail.com) in Senders & IPs -> Senders
# 3. Generate an API Key under SMTP & API -> API Keys
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# --- OPTION C: RESEND HTTP API ---
# Note: Free tier requires owning a custom domain to send to arbitrary public recipients.
# RESEND_API_KEY=re_123456789



# ==============================================================
# PAYMENT GATEWAY & ESCROW QR CONFIGURATION
# ==============================================================
# The UPI ID where customer payments will be deposited for escrow:
UPI_ID=your_merchant_upi_id@okaxis
UPI_PAYEE_NAME=CampusConnect Escrow
# Optional: Path to custom QR code image (e.g. /images/admin-qr.png) or leave empty for auto-generated QR:
UPI_QR_IMAGE=

# ==============================================================
# SUPABASE DATABASE CONFIGURATION (PostgreSQL Cloud Storage)
# ==============================================================
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API:
#    - Project URL: e.g. https://your-project-id.supabase.co
#    - Project API Keys: anon (public) or service_role (secret)
# 3. If left blank, the app will gracefully use local data/*.json storage.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

