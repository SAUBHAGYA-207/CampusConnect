<!-- Top Advertising Carousel -->
<div id="marketplaceAdCarousel" class="carousel slide carousel-fade mb-5 shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel" data-bs-interval="4000">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#marketplaceAdCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#marketplaceAdCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#marketplaceAdCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        <button type="button" data-bs-target="#marketplaceAdCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
    </div>

    <div class="carousel-inner">
        <!-- Slide 1: Peer Mentorship & Tutoring -->
        <div class="carousel-item active" style="height: 360px; position: relative;">
            <img src="/images/banners/banner-teach.jpg" class="d-block w-100 h-100" alt="Peer Mentoring & Tutoring" style="object-fit: cover;">
            <div class="carousel-overlay" style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15, 23, 42, 0.88) 0%, rgba(15, 23, 42, 0.65) 55%, rgba(15, 23, 42, 0.25) 100%);"></div>
            <div class="carousel-caption text-start d-flex flex-column justify-content-center h-100" style="left: 6%; right: 25%; bottom: 0; top: 0;">
                <span class="badge bg-primary px-3 py-2 text-uppercase fw-bold mb-2 align-self-start" style="letter-spacing: 0.8px; font-size: 0.75rem;">
                    🎓 ACADEMICS & TUTORING
                </span>
                <h1 class="display-6 fw-bold text-white mb-2" style="text-shadow: 0 2px 4px rgba(0,0,0,0.3);">
                    Ace Your Exams with Top Peer Mentors
                </h1>
                <p class="lead text-white-50 mb-4 d-none d-md-block" style="max-width: 650px; font-size: 1.05rem;">
                    Get 1-on-1 tutoring, concept clarifications, lab work help, and exam strategies from high-achieving seniors.
                </p>
                <div class="d-flex gap-2">
                    <a href="/marketplace?category=Teach" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">
                        Find a Tutor →
                    </a>
                </div>
            </div>
        </div>

        <!-- Slide 2: Coding, Web & Tech Support -->
        <div class="carousel-item" style="height: 360px; position: relative;">
            <img src="/images/banners/banner-tech.jpg" class="d-block w-100 h-100" alt="Tech & Coding Support" style="object-fit: cover;">
            <div class="carousel-overlay" style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15, 23, 42, 0.88) 0%, rgba(15, 23, 42, 0.65) 55%, rgba(15, 23, 42, 0.25) 100%);"></div>
            <div class="carousel-caption text-start d-flex flex-column justify-content-center h-100" style="left: 6%; right: 25%; bottom: 0; top: 0;">
                <span class="badge bg-info text-dark px-3 py-2 text-uppercase fw-bold mb-2 align-self-start" style="letter-spacing: 0.8px; font-size: 0.75rem;">
                    💻 TECH & DEVELOPMENT
                </span>
                <h1 class="display-6 fw-bold text-white mb-2" style="text-shadow: 0 2px 4px rgba(0,0,0,0.3);">
                    Bug Fixes, Web Design & Tech Assistance
                </h1>
                <p class="lead text-white-50 mb-4 d-none d-md-block" style="max-width: 650px; font-size: 1.05rem;">
                    Need help with coursework, web design, or a technical project? Connect with skilled peer specialists ready to assist.
                </p>
                <div class="d-flex gap-2">
                    <a href="/marketplace?category=Tech" class="btn btn-info px-4 py-2 fw-bold text-dark shadow-sm">
                        Explore Tech Gigs →
                    </a>
                </div>
            </div>
        </div>

        <!-- Slide 3: Creative Arts & Media -->
        <div class="carousel-item" style="height: 360px; position: relative;">
            <img src="/images/banners/banner-arts.jpg" class="d-block w-100 h-100" alt="Creative Arts & Media" style="object-fit: cover;">
            <div class="carousel-overlay" style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15, 23, 42, 0.88) 0%, rgba(15, 23, 42, 0.65) 55%, rgba(15, 23, 42, 0.25) 100%);"></div>
            <div class="carousel-caption text-start d-flex flex-column justify-content-center h-100" style="left: 6%; right: 25%; bottom: 0; top: 0;">
                <span class="badge bg-warning text-dark px-3 py-2 text-uppercase fw-bold mb-2 align-self-start" style="letter-spacing: 0.8px; font-size: 0.75rem;">
                    🎨 CREATIVE & DESIGN
                </span>
                <h1 class="display-6 fw-bold text-white mb-2" style="text-shadow: 0 2px 4px rgba(0,0,0,0.3);">
                    Posters, Video Editing & Event Visuals
                </h1>
                <p class="lead text-white-50 mb-4 d-none d-md-block" style="max-width: 650px; font-size: 1.05rem;">
                    Need a presentation overhaul, club fest banner, or photography? Discover talented creators in your campus community.
                </p>
                <div class="d-flex gap-2">
                    <a href="/marketplace?category=Arts" class="btn btn-warning px-4 py-2 fw-bold text-dark shadow-sm">
                        Discover Creators →
                    </a>
                </div>
            </div>
        </div>

        <!-- Slide 4: Become a Partner & Earn -->
        <div class="carousel-item" style="height: 360px; position: relative;">
            <img src="/images/banners/banner-partner.jpg" class="d-block w-100 h-100" alt="Become a Partner" style="object-fit: cover;">
            <div class="carousel-overlay" style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15, 23, 42, 0.88) 0%, rgba(15, 23, 42, 0.65) 55%, rgba(15, 23, 42, 0.25) 100%);"></div>
            <div class="carousel-caption text-start d-flex flex-column justify-content-center h-100" style="left: 6%; right: 25%; bottom: 0; top: 0;">
                <span class="badge bg-success text-white px-3 py-2 text-uppercase fw-bold mb-2 align-self-start" style="letter-spacing: 0.8px; font-size: 0.75rem;">
                    💼 MONETIZE YOUR TALENT
                </span>
                <h1 class="display-6 fw-bold text-white mb-2" style="text-shadow: 0 2px 4px rgba(0,0,0,0.3);">
                    Offer Your Skills & Earn on Campus
                </h1>
                <p class="lead text-white-50 mb-4 d-none d-md-block" style="max-width: 650px; font-size: 1.05rem;">
                    Join CampusConnect as a PARTNER. Build your client network, secure payments via UPI escrow, and boost your portfolio.
                </p>
                <div class="d-flex gap-2">
                    <a href="/services/create" class="btn btn-success px-4 py-2 fw-bold shadow-sm">
                        Join as a Partner →
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Carousel Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#marketplaceAdCarousel" data-bs-slide="prev" style="width: 5%;">
        <span class="carousel-control-prev-icon p-3 rounded-circle" style="background-color: rgba(15, 23, 42, 0.5);" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#marketplaceAdCarousel" data-bs-slide="next" style="width: 5%;">
        <span class="carousel-control-next-icon p-3 rounded-circle" style="background-color: rgba(15, 23, 42, 0.5);" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<!-- Search and Filter Bar -->
<div class="row mb-5 mt-2">
    <div class="col-md-12 text-center mb-4">
        <h2 class="display-6 fw-bold">Explore Services</h2>
        <p class="text-muted">Find exactly what you need on campus.</p>
    </div>
    <div class="col-md-10 offset-md-1">
        <div class="card p-3 shadow-sm border-0">
            <form class="row g-3 align-items-center" action="/marketplace" method="GET">
                <div class="col-md-4">
                    <input type="text" class="form-control form-control-lg border-0 bg-light" name="q" placeholder="What service are you looking for?" value="<%= query.q || '' %>">
                </div>
                <div class="col-md-2">
                    <select class="form-select border-0 bg-light" name="category">
                        <option value="">All Categories</option>
                        <option value="Teach" <%= query.category === 'Teach' ? 'selected' : '' %>>Teach</option>
                        <option value="Tech" <%= query.category === 'Tech' ? 'selected' : '' %>>Tech</option>
                        <option value="Arts" <%= query.category === 'Arts' ? 'selected' : '' %>>Arts</option>
                        <option value="Writing & Notes" <%= query.category === 'Writing & Notes' ? 'selected' : '' %>>Writing & Notes</option>
                        <option value="Fitness & Sports" <%= query.category === 'Fitness & Sports' ? 'selected' : '' %>>Fitness & Sports</option>
                        <option value="Campus Errands" <%= query.category === 'Campus Errands' ? 'selected' : '' %>>Campus Errands</option>
                        <option value="Others" <%= (query.category === 'Others' || query.category === 'Other') ? 'selected' : '' %>>Others</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="number" class="form-control border-0 bg-light" name="minPrice" placeholder="Min ₹" value="<%= query.minPrice || '' %>">
                </div>
                <div class="col-md-2">
                    <input type="number" class="form-control border-0 bg-light" name="maxPrice" placeholder="Max ₹" value="<%= query.maxPrice || '' %>">
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">Search</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 mb-3 d-flex justify-content-between align-items-center">
        <span class="text-muted fw-medium"><%= services.length %> services found</span>
        <form action="/marketplace" method="GET" class="d-flex align-items-center">
            <!-- Hidden inputs to preserve filters -->
            <input type="hidden" name="q" value="<%= query.q || '' %>">
            <input type="hidden" name="category" value="<%= query.category || '' %>">
            <input type="hidden" name="minPrice" value="<%= query.minPrice || '' %>">
            <input type="hidden" name="maxPrice" value="<%= query.maxPrice || '' %>">
            <span class="text-muted small me-2 text-nowrap">Sort by:</span>
            <select class="form-select form-select-sm border-0 bg-white shadow-sm" name="sortBy" onchange="this.form.submit()" style="width: auto;">
                <option value="">Newest</option>
                <option value="price_asc" <%= query.sortBy === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                <option value="price_desc" <%= query.sortBy === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
            </select>
        </form>
    </div>

    <% if (services.length === 0) { %>
        <div class="col-12 text-center py-5">
            <h4 class="text-muted">No services match your criteria.</h4>
            <a href="/marketplace" class="btn btn-outline-secondary mt-3">Clear Filters</a>
        </div>
    <% } else { %>
        <% services.forEach(service => { %>
            <div class="col-md-4 col-lg-3 mb-4">
                <a href="/marketplace/<%= service.id %>" class="text-decoration-none text-dark">
                    <div class="card h-100 card-hover">
                        <% if (service.image) { %>
                            <img src="<%= service.image %>" class="card-img-top" alt="<%= service.title %>" style="height: 180px; object-fit: cover; border-radius: 16px 16px 0 0;">
                        <% } else { %>
                            <div class="card-img-top bg-light d-flex justify-content-center align-items-center text-muted" style="height: 180px; border-radius: 16px 16px 0 0;">
                                <span>No Image</span>
                            </div>
                        <% } %>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-light text-secondary mb-2 px-2 py-1"><%= service.category %></span>
                                <h5 class="card-title fw-bold mb-1"><%= service.title %></h5>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="text-success fw-bold fs-5 mb-0">₹<%= service.price %></span>
                                <span class="btn btn-sm btn-outline-primary fw-semibold px-3 py-1 rounded-pill">Book →</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        <% }) %>
    <% } %>
</div>

<style>
    #marketplaceAdCarousel .carousel-indicators [data-bs-target] {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin: 0 5px;
        background-color: rgba(255, 255, 255, 0.55);
        border: none;
        transition: all 0.35s ease;
    }
    #marketplaceAdCarousel .carousel-indicators .active {
        width: 32px;
        border-radius: 8px;
        background-color: #ffffff;
    }
    #marketplaceAdCarousel .carousel-control-prev,
    #marketplaceAdCarousel .carousel-control-next {
        opacity: 0.75;
        transition: opacity 0.2s ease;
    }
    #marketplaceAdCarousel:hover .carousel-control-prev,
    #marketplaceAdCarousel:hover .carousel-control-next {
        opacity: 1;
    }
    @media (max-width: 768px) {
        #marketplaceAdCarousel .carousel-item {
            height: 280px !important;
        }
        #marketplaceAdCarousel .carousel-caption {
            left: 5% !important;
            right: 5% !important;
        }
        #marketplaceAdCarousel h1 {
            font-size: 1.4rem !important;
        }
    }
</style>
