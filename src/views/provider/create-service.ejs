<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="mb-3">
            <a href="/services/my-services" onclick="if (window.history.length > 1) { history.back(); return false; }" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-3 py-2 fw-medium" style="border-radius: 8px;">
                ← Back
            </a>
        </div>
        <div class="card p-4 p-md-5 border-0 shadow-sm">
            <h3 class="fw-bold mb-4">Create New Service</h3>

            <% if (error) { %>
                <div class="alert alert-danger py-2 px-3 mb-4 rounded-3 d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-circle-fill flex-shrink-0" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 4a.905.905 0 0 0-.9.995l.35 3.507a.552.552 0 0 0 1.1 0l.35-3.507A.905.905 0 0 0 8 4zm.002 6a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
                    </svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/services/create" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label text-muted fw-medium small">Service Title</label>
                    <input type="text" class="form-control bg-light border-0 py-2" id="title" name="title" required placeholder="e.g. Python Tutoring / Poster Design / Laptop Repair">
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label text-muted fw-medium small">Detailed Description</label>
                    <textarea class="form-control bg-light border-0 py-2" id="description" name="description" rows="4" required placeholder="Describe what you offer, timings, and expectations..."></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="price" class="form-label text-muted fw-medium small">Price (₹)</label>
                        <input type="number" step="0.01" class="form-control bg-light border-0 py-2" id="price" name="price" required placeholder="0.00">
                    </div>
                    <div class="col-md-6 mb-4">
                        <label for="category" class="form-label text-muted fw-medium small">Category</label>
                        <select class="form-select bg-light border-0 py-2" id="category" name="category" required>
                            <option value="Teach">Teach (Tutoring, Lessons, Academics)</option>
                            <option value="Tech">Tech (Coding, Repairs, Web/Apps)</option>
                            <option value="Arts">Arts (Design, Photo/Video, Music)</option>
                            <option value="Writing & Notes">Writing & Notes (Resumes, Reports)</option>
                            <option value="Fitness & Sports">Fitness & Sports</option>
                            <option value="Campus Errands">Campus Errands & Events</option>
                            <option value="Others">Others</option>
                        </select>
                    </div>
                </div>
                <div class="mb-4">
                    <label for="images" class="form-label text-muted fw-medium small d-flex justify-content-between align-items-center">
                        <span>Product / Service Images (Upload multiple, max 8)</span>
                        <span class="badge bg-light text-primary border" id="imageCountBadge">0 selected</span>
                    </label>
                    <input class="form-control bg-light border-0 py-2" type="file" id="images" name="images" multiple accept="image/jpeg, image/png, image/webp" onchange="previewSelectedImages(this)">
                    <div class="form-text small text-muted mt-1">
                        💡 <strong>Amazon-style Carousel:</strong> Select multiple photos. The first image will be the primary cover photo, and users will be able to swipe through all images.
                    </div>
                    
                    <!-- Live Thumbnail Preview Grid -->
                    <div id="imagePreviewContainer" class="d-flex flex-wrap gap-2 mt-3" style="display: none !important;">
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="/services/my-services" class="btn btn-light border py-3 flex-grow-1 fw-bold">Cancel</a>
                    <button type="submit" class="btn btn-primary py-3 flex-grow-1 fw-bold shadow-sm">Publish Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function previewSelectedImages(input) {
    const container = document.getElementById('imagePreviewContainer');
    const badge = document.getElementById('imageCountBadge');
    container.innerHTML = '';
    
    if (!input.files || input.files.length === 0) {
        container.style.setProperty('display', 'none', 'important');
        badge.innerText = '0 selected';
        return;
    }
    
    const count = input.files.length;
    badge.innerText = `${count} selected`;
    container.style.removeProperty('display');
    container.style.display = 'flex';
    
    Array.from(input.files).forEach((file, index) => {
        const reader = new FileReader();
        reader.onload = function(e) {
            const card = document.createElement('div');
            card.className = 'position-relative rounded overflow-hidden shadow-sm border bg-white';
            card.style.width = '100px';
            card.style.height = '100px';
            
            const img = document.createElement('img');
            img.src = e.target.result;
            img.style.width = '100%';
            img.style.height = '100%';
            img.style.objectFit = 'cover';
            
            card.appendChild(img);
            
            if (index === 0) {
                const coverBadge = document.createElement('span');
                coverBadge.className = 'position-absolute top-0 start-0 badge bg-primary m-1 px-1 py-0 fw-semibold';
                coverBadge.style.fontSize = '0.65rem';
                coverBadge.innerText = 'Cover';
                card.appendChild(coverBadge);
            }
            
            const numBadge = document.createElement('span');
            numBadge.className = 'position-absolute bottom-0 end-0 badge bg-dark bg-opacity-75 m-1 px-1 py-0';
            numBadge.style.fontSize = '0.65rem';
            numBadge.innerText = '#' + (index + 1);
            card.appendChild(numBadge);
            
            container.appendChild(card);
        };
        reader.readAsDataURL(file);
    });
}
</script>
