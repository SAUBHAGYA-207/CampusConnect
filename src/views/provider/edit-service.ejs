<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="mb-3">
            <a href="/services/my-services" onclick="if (window.history.length > 1) { history.back(); return false; }" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-3 py-2 fw-medium" style="border-radius: 8px;">
                ← Back
            </a>
        </div>
        <div class="card p-4 p-md-5 border-0 shadow-sm">
            <h3 class="fw-bold mb-4">Edit Service</h3>

            <% if (error) { %>
                <div class="alert alert-danger py-2 px-3 mb-4 rounded-3 d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-circle-fill flex-shrink-0" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 4a.905.905 0 0 0-.9.995l.35 3.507a.552.552 0 0 0 1.1 0l.35-3.507A.905.905 0 0 0 8 4zm.002 6a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
                    </svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/services/<%= service.id %>/edit" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label text-muted fw-medium small">Service Title</label>
                    <input type="text" class="form-control bg-light border-0 py-2" id="title" name="title" value="<%= service.title %>" required>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label text-muted fw-medium small">Detailed Description</label>
                    <textarea class="form-control bg-light border-0 py-2" id="description" name="description" rows="4" required><%= service.description %></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="price" class="form-label text-muted fw-medium small">Price (₹)</label>
                        <input type="number" step="0.01" class="form-control bg-light border-0 py-2" id="price" name="price" value="<%= service.price %>" required>
                    </div>
                    <div class="col-md-6 mb-4">
                        <label for="category" class="form-label text-muted fw-medium small">Category</label>
                        <select class="form-select bg-light border-0 py-2" id="category" name="category" required>
                            <option value="Teach" <%= service.category === 'Teach' ? 'selected' : '' %>>Teach (Tutoring, Lessons, Academics)</option>
                            <option value="Tech" <%= service.category === 'Tech' ? 'selected' : '' %>>Tech (Coding, Repairs, Web/Apps)</option>
                            <option value="Arts" <%= service.category === 'Arts' ? 'selected' : '' %>>Arts (Design, Photo/Video, Music)</option>
                            <option value="Writing & Notes" <%= service.category === 'Writing & Notes' ? 'selected' : '' %>>Writing & Notes (Resumes, Reports)</option>
                            <option value="Fitness & Sports" <%= service.category === 'Fitness & Sports' ? 'selected' : '' %>>Fitness & Sports</option>
                            <option value="Campus Errands" <%= service.category === 'Campus Errands' ? 'selected' : '' %>>Campus Errands & Events</option>
                            <option value="Others" <%= (service.category === 'Others' || service.category === 'Other') ? 'selected' : '' %>>Others</option>
                        </select>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label text-muted fw-medium small d-flex justify-content-between align-items-center">
                        <span>Current Images (<span id="existingCount"><%= (service.images && service.images.length) ? service.images.length : (service.image ? 1 : 0) %></span>)</span>
                        <small class="text-muted">Click 🗑️ to remove an image</small>
                    </label>
                    
                    <!-- Existing Images Gallery -->
                    <div id="existingGallery" class="d-flex flex-wrap gap-2 mb-3">
                        <% const currentImages = (service.images && service.images.length > 0) ? service.images : (service.image ? [service.image] : []); %>
                        <% if (currentImages.length === 0) { %>
                            <div class="p-3 bg-light rounded text-muted small w-100 text-center">No images currently uploaded.</div>
                        <% } else { %>
                            <% currentImages.forEach((imgUrl, idx) => { %>
                                <div class="existing-img-card position-relative rounded overflow-hidden shadow-sm border bg-white" style="width: 100px; height: 100px;">
                                    <img src="<%= imgUrl %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='/images/banners/banner-tech.jpg';">
                                    <input type="hidden" name="existingImages" value="<%= imgUrl %>">
                                    <% if (idx === 0) { %>
                                        <span class="position-absolute top-0 start-0 badge bg-primary m-1 px-1 py-0 fw-semibold" style="font-size: 0.65rem;">Cover</span>
                                    <% } %>
                                    <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 p-0 rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 22px; height: 22px; font-size: 0.75rem;" onclick="removeExistingImg(this)" title="Remove Image">✕</button>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>

                    <label for="images" class="form-label text-muted fw-medium small d-flex justify-content-between align-items-center">
                        <span>Add More Images (Max 8 total)</span>
                        <span class="badge bg-light text-primary border" id="newImageCountBadge">0 new</span>
                    </label>
                    <input class="form-control bg-light border-0 py-2" type="file" id="images" name="images" multiple accept="image/jpeg, image/png, image/webp" onchange="previewNewImages(this)">
                    <div class="form-text small text-muted mt-1">
                        💡 You can select multiple additional images to upload.
                    </div>
                    
                    <!-- New Images Preview -->
                    <div id="newImagesPreview" class="d-flex flex-wrap gap-2 mt-3" style="display: none !important;">
                    </div>
                </div>

                <!-- Delivery Mode & Customer File Upload Requirement -->
                <div class="card p-3 mb-4 rounded-3" style="background-color: var(--champagne-light); border: 1.5px dashed var(--border-warm) !important;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="fs-5">🎨</span>
                        <h6 class="fw-bold mb-0 text-dark">Delivery Mode & Customer Upload Option</h6>
                    </div>
                    <p class="small text-muted mb-3">
                        Does this service work without an in-person meeting (e.g. portrait, design, video editing, essay review)? Enable remote file uploads below so customers can send photos or videos directly when booking.
                    </p>

                    <div class="mb-3">
                        <label for="deliveryMode" class="form-label text-muted fw-semibold small">Service Delivery Format</label>
                        <select class="form-select bg-white border py-2" id="deliveryMode" name="deliveryMode">
                            <option value="flexible" <%= (service.deliveryMode === 'flexible' || !service.deliveryMode) ? 'selected' : '' %>>🌐 Flexible (Online or In-Person)</option>
                            <option value="online" <%= (service.deliveryMode === 'online') ? 'selected' : '' %>>🎨 100% Online / Remote (No Meeting Needed)</option>
                            <option value="in_person" <%= (service.deliveryMode === 'in_person') ? 'selected' : '' %>>🤝 In-Person Meeting Required</option>
                        </select>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="requiresUpload" name="requiresUpload" value="true" <%= (service.requiresUpload) ? 'checked' : '' %> onchange="toggleUploadPrompt(this.checked)">
                        <label class="form-check-label fw-semibold text-dark small" for="requiresUpload">
                            Require customer to upload photo, video, or files upon booking
                        </label>
                        <div class="form-text small text-muted">
                            Customers will see an upload field on the booking form to send their reference image or video directly.
                        </div>
                    </div>

                    <div id="uploadPromptContainer" style="<%= (service.requiresUpload) ? 'display: block;' : 'display: none;' %>">
                        <label for="uploadPrompt" class="form-label text-muted fw-semibold small">Customer Upload Instructions</label>
                        <input type="text" class="form-control bg-white border py-2" id="uploadPrompt" name="uploadPrompt" value="<%= service.uploadPrompt || '' %>" placeholder="e.g. Please upload clear front-facing photo for portrait drawing">
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a href="/services/my-services" class="btn btn-light border py-3 flex-grow-1 fw-bold">Cancel</a>
                    <button type="submit" class="btn btn-primary py-3 flex-grow-1 fw-bold shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function removeExistingImg(btn) {
    const card = btn.closest('.existing-img-card');
    if (card) {
        card.remove();
        updateExistingCount();
    }
}

function updateExistingCount() {
    const cards = document.querySelectorAll('.existing-img-card');
    const badge = document.getElementById('existingCount');
    if (badge) badge.innerText = cards.length;
}

function previewNewImages(input) {
    const container = document.getElementById('newImagesPreview');
    const badge = document.getElementById('newImageCountBadge');
    container.innerHTML = '';
    
    if (!input.files || input.files.length === 0) {
        container.style.setProperty('display', 'none', 'important');
        badge.innerText = '0 new';
        return;
    }
    
    const count = input.files.length;
    badge.innerText = `${count} new`;
    container.style.removeProperty('display');
    container.style.display = 'flex';
    
    Array.from(input.files).forEach((file, index) => {
        const reader = new FileReader();
        reader.onload = function(e) {
            const card = document.createElement('div');
            card.className = 'position-relative rounded overflow-hidden shadow-sm border bg-white';
            card.style.width = '100px';
            card.style.height = '100px';
            
            const img = document.createElement('img');
            img.src = e.target.result;
            img.style.width = '100%';
            img.style.height = '100%';
            img.style.objectFit = 'cover';
            
            card.appendChild(img);
            
            const newBadge = document.createElement('span');
            newBadge.className = 'position-absolute top-0 start-0 badge bg-success m-1 px-1 py-0 fw-semibold';
            newBadge.style.fontSize = '0.65rem';
            newBadge.innerText = 'New';
            card.appendChild(newBadge);
            
            container.appendChild(card);
        };
        reader.readAsDataURL(file);
    });
}

function toggleUploadPrompt(checked) {
    const el = document.getElementById('uploadPromptContainer');
    if (el) el.style.display = checked ? 'block' : 'none';
    const delivery = document.getElementById('deliveryMode');
    if (checked && delivery && delivery.value === 'in_person') {
        delivery.value = 'online';
    }
}
</script>
