<div class="row align-items-center py-5 min-vh-75">
    <div class="col-md-6 text-center text-md-start pe-md-5">
        <h1 class="display-3 fw-bold mb-4" style="letter-spacing: -1px; color: #0f172a;">Discover the perfect local services.</h1>
        <p class="lead text-muted mb-5" style="font-size: 1.25rem;">CampusConnect connects you with top-rated professionals for any job, anywhere. Simple, reliable, and completely seamless.</p>
        <% if (!user) { %>
            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-md-start">
                <a href="/auth/register" class="btn btn-primary btn-lg px-5 shadow-sm">Get Started</a>
                <a href="/marketplace" class="btn btn-outline-secondary btn-lg px-5">Explore</a>
            </div>
        <% } else { %>
            <a href="/marketplace" class="btn btn-primary btn-lg px-5 shadow-sm">Explore Marketplace</a>
        <% } %>
    </div>
    <div class="col-md-6 mt-5 mt-md-0">
        <div class="card bg-light border-0" style="min-height: 400px; background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);">
            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-5">
                <h3 class="fw-bold text-primary mb-3">Join Thousands Today</h3>
                <p class="text-muted">Over 5,000+ services offered in your area.</p>
            </div>
        </div>
    </div>
</div>
