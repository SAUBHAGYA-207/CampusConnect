<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Luxury Palette: Blush, Champagne, Cognac, Amber, Emerald, Espresso */
            --espresso: #241411;
            --espresso-soft: #38241F;
            --espresso-muted: #6B554F;
            --cognac: #963D24;
            --cognac-hover: #7E311B;
            --cognac-subtle: #FDF5F2;
            --amber: #C67408;
            --amber-hover: #A85E00;
            --amber-light: #FEF3C7;
            --emerald: #146B4F;
            --emerald-hover: #0E533C;
            --emerald-light: #EBF7F1;
            --blush: #F4DFD7;
            --blush-deep: #E8C9BA;
            --champagne: #FAF6F0;
            --champagne-light: #FCF9F5;
            --surface: #FFFFFF;
            --border-warm: #EBDAD0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--champagne);
            color: var(--espresso);
            -webkit-font-smoothing: antialiased;
        }
        
        .navbar {
            background-color: var(--surface) !important;
            border-bottom: 1px solid var(--border-warm);
            box-shadow: 0 2px 14px rgba(36, 20, 17, 0.04);
            padding: 1.1rem 0;
        }
        
        .navbar-brand {
            color: var(--espresso) !important;
            font-weight: 700;
            font-size: 1.55rem;
            letter-spacing: -0.5px;
        }
        .navbar-brand .brand-dot {
            color: var(--cognac);
        }
        
        .nav-link {
            color: var(--espresso-muted) !important;
            font-weight: 500;
            transition: all 0.2s;
        }
        
        .nav-link:hover, .nav-link.active {
            color: var(--cognac) !important;
        }
        
        .card {
            border: 1px solid var(--border-warm) !important;
            border-radius: 16px;
            box-shadow: 0 4px 18px -2px rgba(36, 20, 17, 0.05);
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            background: var(--surface);
        }
        
        .card-hover:hover {
            transform: translateY(-3px);
            border-color: var(--blush-deep) !important;
            box-shadow: 0 12px 28px -4px rgba(150, 61, 36, 0.12);
        }
        
        .btn {
            border-radius: 10px;
            font-weight: 600;
            padding: 0.65rem 1.35rem;
            transition: all 0.2s ease;
        }
        
        .btn-primary {
            background-color: var(--cognac);
            border-color: var(--cognac);
            color: #ffffff;
        }
        
        .btn-primary:hover, .btn-primary:focus, .btn-primary:active {
            background-color: var(--cognac-hover) !important;
            border-color: var(--cognac-hover) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 14px rgba(150, 61, 36, 0.35);
        }
        
        .btn-success {
            background-color: var(--emerald);
            border-color: var(--emerald);
            color: #ffffff;
        }

        .btn-success:hover, .btn-success:focus, .btn-success:active {
            background-color: var(--emerald-hover) !important;
            border-color: var(--emerald-hover) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 14px rgba(20, 107, 79, 0.3);
        }

        .btn-outline-primary {
            border-color: var(--cognac);
            color: var(--cognac);
            background-color: transparent;
        }

        .btn-outline-primary:hover, .btn-outline-primary:focus, .btn-outline-primary:active {
            background-color: var(--cognac);
            border-color: var(--cognac);
            color: #ffffff !important;
        }

        .btn-outline-secondary {
            border-color: var(--border-warm);
            color: var(--espresso-soft);
            background-color: var(--surface);
        }

        .btn-outline-secondary:hover {
            background-color: var(--champagne-light);
            border-color: var(--blush-deep);
            color: var(--espresso);
        }
        
        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid var(--border-warm);
            padding: 0.7rem 1.05rem;
            background-color: var(--champagne-light);
            color: var(--espresso);
            transition: all 0.2s ease;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: var(--cognac);
            background-color: #ffffff;
            box-shadow: 0 0 0 3.5px rgba(150, 61, 36, 0.16);
            color: var(--espresso);
        }

        h1, h2, h3, h4, h5, h6 {
            color: var(--espresso);
            font-weight: 700;
            letter-spacing: -0.3px;
        }

        .badge.bg-primary {
            background-color: var(--cognac) !important;
            color: #ffffff !important;
        }

        .badge.bg-success {
            background-color: var(--emerald) !important;
            color: #ffffff !important;
        }

        .badge.bg-warning {
            background-color: var(--amber) !important;
            color: #ffffff !important;
        }

        .badge.bg-danger {
            background-color: #B91C1C !important;
            color: #ffffff !important;
        }

        .notification-dropdown {
            min-width: 320px;
            border-radius: 14px;
            border: 1px solid var(--border-warm);
            box-shadow: 0 12px 30px rgba(36, 20, 17, 0.12);
            padding: 0.5rem;
            background: var(--surface);
        }

        .notification-item {
            padding: 12px;
            border-radius: 8px;
            display: block;
            text-decoration: none;
            color: var(--espresso-soft);
            margin-bottom: 4px;
        }

        .notification-item.unread {
            background-color: var(--blush);
            font-weight: 600;
            color: var(--cognac);
        }

        .notification-item:hover {
            background-color: var(--champagne);
        }

        .stat-card {
            padding: 1.5rem;
            border-radius: 16px;
        }
        .stat-card-title {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            opacity: 0.85;
        }
        .stat-card-value {
            font-size: 2.3rem;
            font-weight: 700;
            margin-top: 0.4rem;
        }

        /* Floating Circular Admin Support Chat Button */
        .floating-chat-btn {
            position: fixed;
            bottom: 28px;
            right: 28px;
            width: 58px;
            height: 58px;
            border-radius: 50% !important;
            background: linear-gradient(135deg, var(--cognac) 0%, var(--espresso) 100%);
            border: 2px solid var(--champagne-light);
            box-shadow: 0 8px 24px rgba(150, 61, 36, 0.45);
            z-index: 1060;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff !important;
            text-decoration: none !important;
            transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .floating-chat-btn:hover {
            transform: scale(1.1) translateY(-3px);
            background: linear-gradient(135deg, var(--cognac-hover) 0%, #1A0D0A 100%);
            box-shadow: 0 12px 28px rgba(150, 61, 36, 0.6);
            color: #ffffff !important;
        }

        .floating-chat-btn:active {
            transform: scale(0.95);
        }

        .floating-chat-pulse {
            position: absolute;
            top: 2px;
            right: 2px;
            width: 14px;
            height: 14px;
            background-color: var(--amber);
            border: 2px solid #ffffff;
            border-radius: 50%;
            box-shadow: 0 0 8px rgba(198, 116, 8, 0.9);
        }

        /* Perfectly Aligned Partner Checkbox Component */
        .partner-checkbox-card {
            background-color: var(--champagne-light);
            border: 1.5px solid var(--border-warm);
            border-radius: 12px;
            padding: 14px 18px;
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0;
            box-sizing: border-box;
        }

        .partner-checkbox-card:hover {
            background-color: var(--blush);
            border-color: var(--cognac);
        }

        .partner-checkbox-input {
            width: 22px;
            height: 22px;
            accent-color: var(--cognac);
            cursor: pointer;
            margin: 0 !important;
            float: none !important;
            flex-shrink: 0;
        }
    </style>
</head>
<body>
    <% if (!user || user.role !== 'admin') { %>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/">CampusConnect<span class="brand-dot">.</span></a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item me-2">
                        <a class="nav-link" href="/marketplace">Marketplace</a>
                    </li>
                    <% if (user) { %>
                        <li class="nav-item me-2">
                            <a class="nav-link" href="/dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item me-3">
                            <a class="nav-link" href="/appointments/my-bookings">My Bookings</a>
                        </li>
                        
                        <!-- Notifications Dropdown -->
                        <li class="nav-item dropdown me-4">
                            <a class="nav-link dropdown-toggle position-relative" href="#" id="notifDropdown" role="button" data-bs-toggle="dropdown">
                                Notifications 
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notif-count" style="display:none; font-size: 0.65rem;">0</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end notification-dropdown" id="notif-list">
                                <div class="p-3 text-center text-muted">Loading...</div>
                            </div>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown">
                                <span><%= user.email %></span>
                                <% if (user.role === 'provider') { %>
                                    <span class="badge bg-primary text-white ms-1 fw-bold" style="font-size: 0.7rem;">PARTNER</span>
                                <% } %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm" style="border-radius: 12px;">
                                <% if (user.role === 'provider') { %>
                                    <li><span class="dropdown-header text-uppercase fw-bold text-primary small">Partner Portal</span></li>
                                    <li><a class="dropdown-item" href="/appointments/provider">Client Orders & Proofs</a></li>
                                    <li><a class="dropdown-item" href="/services/my-services">My Service Listings</a></li>
                                    <li><a class="dropdown-item" href="/services/create">+ Add New Service</a></li>
                                    <li><a class="dropdown-item" href="/dashboard#payout-section">💳 Payouts & QR Settlement</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                <% } %>
                                <li><a class="dropdown-item text-danger" href="/auth/logout">Logout</a></li>
                            </ul>
                        </li>
                    <% } else { %>
                        <li class="nav-item me-2">
                            <a class="nav-link" href="/auth/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary" href="/auth/register">Sign Up</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>
    <% } %>
    
    <div class="container py-5">
        <!-- Flash Toasts -->
        <div class="toast-container position-fixed bottom-0 end-0 p-3 pb-5 pe-4 mb-5" style="z-index: 1050;">
            <% if (success_messages && success_messages.length > 0) { %>
                <% success_messages.forEach(msg => { %>
                    <div class="toast align-items-center text-bg-success border-0 show shadow-lg mb-3" style="border-radius: 12px;" role="alert">
                        <div class="d-flex">
                            <div class="toast-body fw-medium"><%= msg %></div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>
                <% }) %>
            <% } %>
            <% if (error_messages && error_messages.length > 0) { %>
                <% error_messages.forEach(msg => { %>
                    <div class="toast align-items-center text-bg-danger border-0 show shadow-lg mb-3" style="border-radius: 12px;" role="alert">
                        <div class="d-flex">
                            <div class="toast-body fw-medium"><%= msg %></div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>

        <%- body %>
    </div>

    <!-- Floating Circular Admin Support Chat Button (Available to User & Partner) -->
    <% if (!user || user.role !== 'admin') { %>
        <% if (typeof path === 'undefined' || !path.startsWith('/support/chat')) { %>
            <a href="<%= user ? '/support/chat' : '/auth/login' %>" 
               class="floating-chat-btn" 
               title="💬 Chat with Super Admin Support" 
               aria-label="Admin Support Chat" 
               id="floatingAdminChatBtn">
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-chat-dots-fill text-white" viewBox="0 0 16 16">
                    <path d="M16 8c0 3.866-3.582 7-8 7a9 9 0 0 1-2.347-.306c-.584.296-1.925.864-4.181 1.234-.2.032-.352-.176-.273-.362.354-.836.674-1.95.77-2.966C.744 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7M5 8a1 1 0 1 0-2 0 1 1 0 0 0 2 0m4 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0m4 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0"/>
                </svg>
                <span class="floating-chat-pulse"></span>
            </a>
        <% } %>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <% if (user) { %>
        <script src="/socket.io/socket.io.js"></script>
        <script>
            window.socket = io();
            const userId = "<%= user.id %>";
            window.socket.emit('join_user_room', userId);

            const notifList = document.getElementById('notif-list');
            const notifCount = document.getElementById('notif-count');

            function renderNotifications(notifs) {
                let unreadCount = 0;
                notifList.innerHTML = '';
                if(notifs.length === 0) {
                    notifList.innerHTML = '<div class="p-3 text-center text-muted">No notifications</div>';
                    return;
                }
                notifs.forEach(n => {
                    if(!n.read) unreadCount++;
                    const a = document.createElement('a');
                    a.href = '#';
                    a.className = `notification-item ${!n.read ? 'unread' : ''}`;
                    a.innerText = n.message;
                    a.onclick = (e) => {
                        e.preventDefault();
                        fetch(`/api/notifications/${n.id}/read`, { method: 'POST' })
                            .then(() => window.location.href = n.link);
                    };
                    notifList.appendChild(a);
                });
                notifCount.innerText = unreadCount;
                if(unreadCount === 0) notifCount.style.display = 'none';
                else notifCount.style.display = 'inline-block';
            }

            fetch('/api/notifications')
                .then(r => r.json())
                .then(notifs => renderNotifications(notifs));

            window.socket.on('new_notification', (n) => {
                fetch('/api/notifications')
                    .then(r => r.json())
                    .then(notifs => renderNotifications(notifs));
                
                const toastHtml = `
                    <div class="toast align-items-center text-bg-primary border-0 show shadow-lg mb-3" style="border-radius: 12px;" role="alert">
                        <div class="d-flex">
                            <div class="toast-body fw-medium">${n.message}</div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>`;
                document.querySelector('.toast-container').insertAdjacentHTML('afterbegin', toastHtml);
            });
        </script>
    <% } %>
</body>
</html>
