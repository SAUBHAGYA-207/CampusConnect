<div class="row justify-content-center align-items-center" style="min-height: 65vh;">
    <div class="col-md-5 col-lg-4">
        <div class="mb-3">
            <a href="/auth/login" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-3 py-2 fw-medium" style="border-radius: 8px;" onclick="if (window.history.length > 1) { history.back(); return false; }">
                ← Back
            </a>
        </div>
        <div class="card p-4 p-md-5 shadow-sm border-0" style="border: 1px solid var(--border-warm) !important; border-radius: 18px;">
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background-color: var(--blush); color: var(--cognac);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-key-fill" viewBox="0 0 16 16">
                        <path d="M3.5 11.5a3.5 3.5 0 1 1 3.163-5H14L15.5 8 14 9.5l-1-1-1 1-1-1-1 1-1.337-1.337A3.5 3.5 0 0 1 3.5 11.5ZM3 6a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/>
                    </svg>
                </div>
                <h3 class="fw-bold mb-1" style="color: var(--espresso); letter-spacing: -0.5px;">Forgot Password?</h3>
                <p class="text-muted small">Enter your email and we'll send a 6-digit OTP to reset your password</p>
            </div>

            <% if (error) { %>
                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3" style="background-color: #FDF2F2; border-color: #F8B4B4; color: #9B1C1C;"><%= error %></div>
            <% } %>

            <form action="/auth/forgot-password" method="POST">
                <div class="mb-4">
                    <label for="email" class="form-label text-muted fw-semibold small">Registered Email Address</label>
                    <input type="email" class="form-control form-control-lg" id="email" name="email" placeholder="name@domain.com" autofocus required>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm fw-bold">Send Reset OTP</button>
            </form>

            <div class="text-center mt-4 pt-3 border-top" style="border-color: var(--border-warm) !important;">
                <small class="text-muted">Remember your password? <a href="/auth/login" class="text-decoration-none fw-semibold" style="color: var(--cognac);">Sign in</a></small>
            </div>
        </div>
    </div>
</div>
