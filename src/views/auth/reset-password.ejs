<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-6 col-lg-5">
        <div class="mb-3">
            <a href="/auth/forgot-password" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-3 py-2 fw-medium" style="border-radius: 8px;" onclick="if (window.history.length > 1) { history.back(); return false; }">
                ← Back
            </a>
        </div>
        <div class="card p-4 p-md-5 border-0 shadow-sm" style="border: 1px solid var(--border-warm) !important; border-radius: 18px;">
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background-color: var(--blush); color: var(--cognac);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-shield-lock-fill" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm0 5a1.5 1.5 0 0 1 1.5 1.5v.5h.5a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1h.5v-.5A1.5 1.5 0 0 1 8 5zm.5 2v-.5a.5.5 0 0 0-1 0V7h1z"/>
                    </svg>
                </div>
                <h3 class="fw-bold mb-1" style="color: var(--espresso); letter-spacing: -0.5px;">Set New Password</h3>
                <p class="text-muted small mb-0">
                    We sent a 6-digit reset code to
                    <br><strong style="color: var(--espresso);"><%= typeof resetEmail !== 'undefined' && resetEmail ? resetEmail : 'your email address' %></strong>
                </p>
            </div>

            <% if (typeof resent !== 'undefined' && resent) { %>
                <div class="alert alert-success d-flex align-items-center py-2 px-3 small rounded-3 mb-3" style="background-color: var(--emerald-light); border-color: #A7F3D0; color: var(--emerald);" role="alert">
                    <span class="me-2">✓</span> A fresh verification code has been dispatched to your email.
                </div>
            <% } %>

            <% if (error) { %>
                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3" style="background-color: #FDF2F2; border-color: #F8B4B4; color: #9B1C1C;"><%= error %></div>
            <% } %>

            <form action="/auth/reset-password" method="POST">
                <div class="mb-3">
                    <label for="otp" class="form-label text-muted fw-semibold small">Enter 6-Digit Verification Code</label>
                    <input type="text" class="form-control form-control-lg text-center fw-bold letter-spacing-lg font-monospace" id="otp" name="otp" maxlength="6" placeholder="000000" autofocus required style="letter-spacing: 6px; font-size: 1.5rem; border-color: var(--border-warm); background-color: var(--champagne-light);">
                </div>

                <div class="mb-3">
                    <label for="newPassword" class="form-label text-muted fw-semibold small">New Password</label>
                    <input type="password" class="form-control form-control-lg" id="newPassword" name="newPassword" minlength="6" placeholder="At least 6 characters" required>
                </div>

                <div class="mb-4">
                    <label for="confirmPassword" class="form-label text-muted fw-semibold small">Confirm New Password</label>
                    <input type="password" class="form-control form-control-lg" id="confirmPassword" name="confirmPassword" minlength="6" placeholder="Re-enter new password" required>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm mb-3">Update Password & Sign In</button>
            </form>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: var(--border-warm) !important;">
                <span class="text-muted small">Didn't receive code?</span>
                <form action="/auth/forgot-password/resend" method="POST" class="m-0" id="resendResetForm">
                    <button type="submit" class="btn btn-link p-0 text-decoration-none fw-semibold small" id="resendResetBtn" style="color: var(--cognac);">
                        Resend Code
                    </button>
                </form>
            </div>

            <div class="mt-4 p-3 rounded-3 text-center" style="background-color: var(--champagne-light); border: 1px solid var(--border-warm);">
                <small class="text-muted d-block" style="font-size: 0.8rem; line-height: 1.4;">
                    🔒 <strong>Security Notice:</strong> The reset code is valid for 10 minutes. If you do not see it in your inbox, please check your spam folder.
                </small>
            </div>

            <div class="text-center mt-3">
                <a href="/auth/login" class="text-muted small text-decoration-none" onclick="if (window.history.length > 1) { history.back(); return false; }">← Back to Login</a>
            </div>
        </div>
    </div>
</div>

<script>
    const resendBtn = document.getElementById('resendResetBtn');
    const resendForm = document.getElementById('resendResetForm');
    const cooldownKey = 'reset_otp_resend_cooldown';

    function checkCooldown() {
        const lastSent = localStorage.getItem(cooldownKey);
        if (lastSent) {
            const elapsed = Math.floor((Date.now() - parseInt(lastSent, 10)) / 1000);
            if (elapsed < 60) {
                const remaining = 60 - elapsed;
                resendBtn.disabled = true;
                resendBtn.innerText = `Resend in ${remaining}s`;
                setTimeout(checkCooldown, 1000);
                return;
            }
        }
        resendBtn.disabled = false;
        resendBtn.innerText = 'Resend Code';
    }

    <% if (typeof resent !== 'undefined' && resent) { %>
        localStorage.setItem(cooldownKey, Date.now().toString());
    <% } %>

    checkCooldown();

    if (resendForm) {
        resendForm.addEventListener('submit', () => {
            localStorage.setItem(cooldownKey, Date.now().toString());
        });
    }
</script>
