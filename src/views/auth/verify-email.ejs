<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-6 col-lg-5">
        <div class="mb-3">
            <a href="/auth/login" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-3 py-2 fw-medium" style="border-radius: 8px;" onclick="if (window.history.length > 1) { history.back(); return false; }">
                ← Back
            </a>
        </div>
        <div class="card p-4 p-md-5 border-0 shadow-sm" style="border: 1px solid var(--border-warm) !important; border-radius: 18px;">
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background-color: var(--blush); color: var(--cognac);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-envelope-check-fill" viewBox="0 0 16 16">
                        <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z"/>
                    </svg>
                </div>
                <h3 class="fw-bold mb-1" style="color: var(--espresso); letter-spacing: -0.5px;">Verify Your Email</h3>
                <p class="text-muted small mb-0">
                    We sent a 6-digit verification code to
                    <br><strong style="color: var(--espresso);"><%= typeof userEmail !== 'undefined' && userEmail ? userEmail : 'your email address' %></strong>
                </p>
            </div>

            <% if (typeof resent !== 'undefined' && resent) { %>
                <div class="alert alert-success d-flex align-items-center py-2 px-3 small rounded-3 mb-3" style="background-color: var(--emerald-light); border-color: #A7F3D0; color: var(--emerald);" role="alert">
                    <span class="me-2">✓</span> A fresh verification code has been dispatched to your email address.
                </div>
            <% } else if (typeof sent !== 'undefined' && sent) { %>
                <div class="alert alert-info d-flex align-items-center py-2 px-3 small rounded-3 mb-3" style="background-color: var(--champagne-light); border-color: var(--border-warm); color: var(--espresso-soft);" role="alert">
                    <span class="me-2">ℹ</span> A verification code was dispatched to your email address.
                </div>
            <% } %>

            <% if (error) { %>
                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3" style="background-color: #FDF2F2; border-color: #F8B4B4; color: #9B1C1C;"><%= error %></div>
            <% } %>

            <form action="/auth/verify-email" method="POST">
                <div class="mb-4">
                    <label for="otp" class="form-label text-muted fw-semibold small">Enter 6-Digit OTP</label>
                    <input type="text" class="form-control form-control-lg text-center fw-bold letter-spacing-lg font-monospace" id="otp" name="otp" maxlength="6" placeholder="000000" autofocus required style="letter-spacing: 6px; font-size: 1.6rem; border-color: var(--border-warm); background-color: var(--champagne-light);">
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm mb-3">Verify & Continue</button>
            </form>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: var(--border-warm) !important;">
                <span class="text-muted small">Didn't receive code?</span>
                <form action="/auth/resend-otp" method="POST" class="m-0" id="resendForm">
                    <button type="submit" class="btn btn-link p-0 text-decoration-none fw-semibold small" id="resendBtn" style="color: var(--cognac);">
                        Resend OTP
                    </button>
                </form>
            </div>

            <div class="mt-4 p-3 rounded-3 text-center" style="background-color: var(--champagne-light); border: 1px solid var(--border-warm);">
                <small class="text-muted d-block" style="font-size: 0.8rem; line-height: 1.4;">
                    🔒 <strong>Security Notice:</strong> This one-time passcode is valid for 10 minutes. If you do not see it in your inbox, please check your spam folder.
                </small>
            </div>

            <div class="text-center mt-3">
                <a href="/auth/login" class="text-muted small text-decoration-none" onclick="if (window.history.length > 1) { history.back(); return false; }">← Back to Login</a>
            </div>
        </div>
    </div>
</div>

<script>
    // 60-second cooldown on resend button
    const resendBtn = document.getElementById('resendBtn');
    const resendForm = document.getElementById('resendForm');
    
    // Check if cooldown is active from session/storage
    const cooldownKey = 'otp_resend_cooldown';
    function checkCooldown() {
        const lastSent = localStorage.getItem(cooldownKey);
        if (lastSent) {
            const elapsed = Math.floor((Date.now() - parseInt(lastSent, 10)) / 1000);
            if (elapsed < 60) {
                const remaining = 60 - elapsed;
                resendBtn.disabled = true;
                resendBtn.innerText = `Resend in ${remaining}s`;
                setTimeout(checkCooldown, 1000);
                return;
            }
        }
        resendBtn.disabled = false;
        resendBtn.innerText = 'Resend OTP';
    }

    <% if ((typeof resent !== 'undefined' && resent) || (typeof sent !== 'undefined' && sent)) { %>
        localStorage.setItem(cooldownKey, Date.now().toString());
    <% } %>

    checkCooldown();

    if (resendForm) {
        resendForm.addEventListener('submit', () => {
            localStorage.setItem(cooldownKey, Date.now().toString());
        });
    }
</script>
