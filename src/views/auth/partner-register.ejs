<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-5 col-lg-4">
        <div class="mb-3">
            <a href="/" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-3 py-2 fw-medium" style="border-radius: 8px;" onclick="if (window.history.length > 1) { history.back(); return false; }">
                ← Back
            </a>
        </div>
        <div class="card p-4 p-md-5 shadow-sm border-0" style="border: 1px solid var(--border-warm) !important; border-radius: 18px;">
            <div class="text-center mb-4">
                <span class="badge bg-primary text-white px-3 py-1 rounded-pill small fw-semibold mb-2">💼 Partner Onboarding</span>
                <h3 class="fw-bold mb-1" style="color: var(--espresso); letter-spacing: -0.5px;">Join as a Partner</h3>
                <p class="text-muted small">Offer your skills, accept client bookings, and earn directly on campus</p>
            </div>
            <% if (error) { %>
                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3" style="background-color: #FDF2F2; border-color: #F8B4B4; color: #9B1C1C;"><%= error %></div>
            <% } %>
            <form action="/auth/partner/register" method="POST">
                <input type="hidden" name="role" value="provider">
                <div class="mb-3">
                    <label for="email" class="form-label text-muted fw-semibold small">College or Personal Email</label>
                    <input type="email" class="form-control form-control-lg" id="email" name="email" placeholder="name@domain.com" required>
                </div>
                <div class="mb-4">
                    <label for="password" class="form-label text-muted fw-semibold small">Create Password</label>
                    <input type="password" class="form-control form-control-lg" id="password" name="password" placeholder="••••••••" required>
                </div>

                <div class="mb-4 p-3 rounded-3" style="background-color: #F0FDF4; border: 1px solid #BBF7D0;">
                    <div class="small fw-semibold text-success mb-1">✓ Partner Perks</div>
                    <ul class="small text-muted mb-0 ps-3">
                        <li>List unlimited campus services</li>
                        <li>Support remote deliverables (portrait/photo/video uploads)</li>
                        <li>Receive 90% direct earnings via secure UPI escrow</li>
                    </ul>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm fw-bold">Register as Campus Partner</button>
            </form>

            <div class="p-3 mt-4 rounded-3 text-center" style="background-color: var(--champagne-light); border: 1px dashed var(--border-warm);">
                <span class="small text-muted d-block mb-1">Looking to book campus services?</span>
                <a href="/auth/register" class="small text-decoration-none fw-bold" style="color: var(--cognac);">
                    🛍️ Sign up as a Customer instead →
                </a>
            </div>

            <div class="text-center mt-3">
                <small class="text-muted">Already a partner? <a href="/auth/partner/login" class="text-decoration-none fw-semibold" style="color: var(--cognac);">Sign in</a></small>
            </div>
        </div>
    </div>
</div>
