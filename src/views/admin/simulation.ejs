<div class="modal fade" id="createAppointmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark">Create Simulated Order / Booking</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/simulation/appointments/create" method="POST" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Select Student Buyer (Customer)</label>
                            <select name="customerId" class="form-select" required>
                                <% users.filter(u => u.role === 'customer').forEach(c => { %>
                                    <option value="<%= c.id %>"><%= c.displayName %> (<%= c.email %>)</option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Select Service</label>
                            <select name="serviceId" class="form-select" required>
                                <% allServices.forEach(s => { %>
                                    <option value="<%= s.id %>"><%= s.title %> — ₹<%= s.price %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Booking Date</label>
                            <input type="date" name="date" class="form-control" value="2026-10-21" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Time Slot</label>
                            <input type="text" name="time" class="form-control" value="16:00" placeholder="e.g. 14:00, 18:30" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Order Status</label>
                            <select name="status" class="form-select">
                                <option value="accepted" selected>Accepted (Active in-progress)</option>
                                <option value="completed">Completed (Successfully delivered)</option>
                                <option value="pending">Pending (Awaiting partner response)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Payment Status</label>
                            <select name="paymentStatus" class="form-select">
                                <option value="verified" selected>Verified (Paid ✓)</option>
                                <option value="submitted">Submitted (Screenshot uploaded)</option>
                                <option value="pending">Pending</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">UPI Transaction ID / UTR</label>
                            <input type="text" name="transactionId" class="form-control" value="UPI/20261021/984321">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Payment Proof Image (Optional)</label>
                            <input type="file" name="paymentScreenshot" class="form-control" accept="image/*">
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Booking Notes / Requirements</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="e.g. Need assistance with upcoming midterm exam preparation..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold px-4">Generate Booking</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function togglePartnerFields() {
    const role = document.getElementById('personaRoleSelect').value;
    const partnerFields = document.getElementById('partnerFields');
    if (role === 'provider') {
        partnerFields.style.display = 'block';
    } else {
        partnerFields.style.display = 'none';
    }
}

function updatePersonaColor() {
    const isCustomer = document.getElementById('senderCust').checked;
    const sendBtn = document.getElementById('simSendBtn');
    if (sendBtn) {
        if (isCustomer) {
            sendBtn.className = 'btn btn-primary rounded-pill px-4 fw-bold';
            sendBtn.textContent = 'Send as Customer';
        } else {
            sendBtn.className = 'btn btn-success rounded-pill px-4 fw-bold';
            sendBtn.textContent = 'Send as Partner';
        }
    }
}

function filterSimChatRooms() {
    const query = (document.getElementById('simChatSearch').value || '').toLowerCase().trim();
    const items = document.querySelectorAll('.sim-room-item');
    items.forEach(el => {
        const text = (el.getAttribute('data-search') || '').toLowerCase();
        if (text.includes(query)) {
            el.style.display = 'block';
        } else {
            el.style.display = 'none';
        }
    });
}

document.addEventListener('DOMContentLoaded', () => {
    updatePersonaColor();

    const simChatBox = document.getElementById('simChatBox');
    if (simChatBox) {
        simChatBox.scrollTop = simChatBox.scrollHeight;
    }

    <% if (activeRoom) { %>
        const activeAppointmentId = "<%= activeRoom.appointmentId %>";
        const customerId = "<%= activeRoom.customer.id %>";
        const providerId = "<%= activeRoom.provider.id %>";

        // Connect socket for real-time live chat inside simulation room
        if (window.socket) {
            window.socket.emit('join_appointment_room', { 
                appointmentId: activeAppointmentId, 
                userId: customerId, 
                isMasterAdmin: true 
            });

            window.socket.on('new_message', (msg) => {
                if (msg.appointmentId === activeAppointmentId) {
                    appendSimMessage(msg);
                }
            });
        }

        const simChatForm = document.getElementById('simChatForm');
        if (simChatForm) {
            simChatForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const textInput = document.getElementById('simChatInput');
                const fileInput = document.getElementById('simFileInput');
                const timeInput = document.getElementById('simCustomTimestamp');
                const statusInput = document.getElementById('simMsgStatus');
                const isCustomer = document.getElementById('senderCust').checked;

                const text = textInput.value.trim();
                const file = fileInput.files ? fileInput.files[0] : null;

                if (!text && !file) return;

                const senderRole = isCustomer ? 'customer' : 'provider';
                const senderId = isCustomer ? customerId : providerId;

                const formData = new FormData();
                formData.append('senderId', senderId);
                formData.append('senderRole', senderRole);
                formData.append('text', text);
                formData.append('status', statusInput.value);
                if (timeInput && timeInput.value) {
                    formData.append('customTimestamp', timeInput.value);
                }
                if (file) {
                    formData.append('image', file);
                }

                try {
                    const res = await fetch(`/admin/simulation/api/chat/${activeAppointmentId}/send`, {
                        method: 'POST',
                        body: formData
                    });
                    const data = await res.json();
                    if (data.success && data.message) {
                        appendSimMessage(data.message);
                        textInput.value = '';
                        fileInput.value = '';
                    } else {
                        alert('Error sending message: ' + (data.error || 'Unknown error'));
                    }
                } catch (err) {
                    console.error('Sim chat error:', err);
                    alert('Failed to send message.');
                }
            });
        }

        function appendSimMessage(msg) {
            if (!simChatBox) return;
            const isCust = msg.senderRole === 'customer';
            const date = new Date(msg.timestamp || Date.now());
            const timeString = isNaN(date) ? '' : date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            const div = document.createElement('div');
            div.className = `message-bubble ${isCust ? 'align-self-start' : 'align-self-end'}`;
            div.style.maxWidth = '80%';
            div.style.padding = '8px 12px';
            div.style.borderRadius = '12px';
            div.style.backgroundColor = isCust ? '#ffffff' : '#d9fdd3';
            div.style.boxShadow = '0 1px 1px rgba(0,0,0,0.1)';

            let imgHtml = '';
            if (msg.imageUrl) {
                imgHtml = `<img src="${msg.imageUrl}" class="img-fluid rounded border mb-2 d-block" style="max-height: 200px; cursor: pointer;" onclick="openImageLightbox('${msg.imageUrl}', 'Chat Attachment')">`;
            }

            const senderLabel = isCust ? '👤 <%= activeRoom.customer.name %> (Customer)' : '💼 <%= activeRoom.provider.name %> (Partner)';
            const labelColor = isCust ? '#2563eb' : '#15803d';

            div.innerHTML = `
                <div class="d-flex justify-content-between align-items-center gap-2 mb-1" style="font-size: 0.7rem;">
                    <strong style="color: ${labelColor};">${senderLabel}</strong>
                    <span class="text-muted">${timeString}</span>
                </div>
                ${imgHtml}
                <div style="font-size: 0.92rem; color: #111b21;">${msg.text}</div>
            `;

            simChatBox.appendChild(div);
            simChatBox.scrollTop = simChatBox.scrollHeight;
        }
    <% } %>
});
</script>
