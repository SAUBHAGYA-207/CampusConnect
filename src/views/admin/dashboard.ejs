<div class="row mb-4 align-items-center">
    <div class="col-md-7">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-danger px-3 py-1 text-uppercase fw-bold" style="letter-spacing: 0.5px;">Super Admin Portal</span>
            <span class="text-muted small">CampusConnect Master Command</span>
        </div>
        <h2 class="fw-bold mb-0 text-dark">Executive Dashboard & Revenue Center</h2>
        <p class="text-muted mb-0 small">Logged in as master administrator: <strong><%= adminUser.email %></strong></p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end gap-2">
        <a href="/admin/chat" class="btn btn-primary fw-bold shadow-sm d-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chat-dots-fill" viewBox="0 0 16 16">
                <path d="M16 8c0 3.866-3.582 7-8 7a9.06 9.06 0 0 1-2.347-.306c-.584.296-1.925.864-4.181 1.234-.2.032-.352-.176-.273-.362.354-.836.674-1.95.77-2.966C.744 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7zM5 8a1 1 0 1 0-2 0 1 1 0 0 0 2 0zm4 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0zm4 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0z"/>
            </svg>
            <span>Live Support Messenger</span>
        </a>
        <a href="/admin/logout" class="btn btn-outline-danger fw-bold shadow-sm d-flex align-items-center gap-1">
            <span>Logout</span>
        </a>
    </div>
</div>

<!-- Financial Revenue Dashboard -->
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="card p-3 border-0 shadow-sm" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: #ffffff; border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small text-white-50 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Gross Volume</span>
                <span class="badge bg-white text-dark fw-bold">Completed</span>
            </div>
            <div class="fs-2 fw-bold text-white">₹<%= stats.totalGrossRevenue %></div>
            <small class="text-white-50 mt-1 d-block" style="font-size: 0.75rem;">From <%= stats.completedAppointments %> settled transactions</small>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card p-3 border-0 shadow-sm" style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small text-white-50 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Platform Revenue</span>
                <span class="badge bg-white text-primary fw-bold">Admin Revenue</span>
            </div>
            <div class="fs-2 fw-bold text-white">₹<%= stats.totalPlatformCommission %></div>
            <small class="text-white-50 mt-1 d-block" style="font-size: 0.75rem;">Net commission retained by CampusConnect</small>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card p-3 border-0 shadow-sm" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #ffffff; border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small text-white-50 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Partner Net Earnings</span>
                <span class="badge bg-white text-success fw-bold">Total Earned</span>
            </div>
            <div class="fs-2 fw-bold text-white">₹<%= stats.totalPartnerShare %></div>
            <small class="text-white-50 mt-1 d-block" style="font-size: 0.75rem;">Total owed across all active partners</small>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card p-3 border-0 shadow-sm" style="background-color: #fffbeb; border: 1px solid #fef3c7 !important; color: #92400e; border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small text-muted text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Pending Settlements</span>
                <span class="badge bg-<%= Number(stats.totalPendingPayouts) > 0 ? 'warning text-dark' : 'success' %> fw-bold">
                    <%= Number(stats.totalPendingPayouts) > 0 ? 'Action Needed' : 'All Clear' %>
                </span>
            </div>
            <div class="fs-2 fw-bold text-dark">₹<%= stats.totalPendingPayouts %></div>
            <small class="text-muted mt-1 d-block" style="font-size: 0.75rem;">Settled so far: <strong>₹<%= stats.totalClearedPayouts %></strong></small>
        </div>
    </div>
</div>

<!-- Secondary Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="p-3 bg-white rounded-3 shadow-sm border text-center">
            <div class="text-muted small fw-semibold">Total Customers</div>
            <div class="fs-4 fw-bold text-dark"><%= stats.totalUsers %></div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="p-3 bg-white rounded-3 shadow-sm border text-center">
            <div class="text-muted small fw-semibold">Active Partners</div>
            <div class="fs-4 fw-bold text-primary"><%= stats.totalPartners %></div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="p-3 bg-white rounded-3 shadow-sm border text-center">
            <div class="text-muted small fw-semibold">Services Listed</div>
            <div class="fs-4 fw-bold text-success"><%= stats.totalServices %></div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="p-3 bg-white rounded-3 shadow-sm border text-center">
            <div class="text-muted small fw-semibold">Total Orders</div>
            <div class="fs-4 fw-bold text-dark"><%= stats.totalAppointments %></div>
        </div>
    </div>
</div>

<!-- Nav Tabs -->
<ul class="nav nav-pills mb-4 gap-2 bg-white p-2 rounded-4 shadow-sm border" id="adminTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold px-4 py-2" id="payouts-tab-btn" data-bs-toggle="pill" data-bs-target="#payouts-tab" type="button" role="tab">
            💳 Partner Settlements & Payouts (<%= payouts.filter(p => p.status === 'pending').length %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold px-4 py-2" id="services-tab-btn" data-bs-toggle="pill" data-bs-target="#services-tab" type="button" role="tab">
            🛠️ Service Moderation (<%= services.length %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold px-4 py-2" id="orders-tab-btn" data-bs-toggle="pill" data-bs-target="#orders-tab" type="button" role="tab">
            📦 Bookings & Orders (<%= appointments.length %>)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold px-4 py-2" id="users-tab-btn" data-bs-toggle="pill" data-bs-target="#users-tab" type="button" role="tab">
            👥 Users & Partners Directory
        </button>
    </li>
</ul>

<!-- Tab Contents -->
<div class="tab-content" id="adminTabsContent">
    <!-- TAB 1: PARTNER PAYOUTS & QR SETTLEMENT -->
    <div class="tab-pane fade show active" id="payouts-tab" role="tabpanel">
        <!-- SINGLE WINDOW: DEMANDED PARTNER CLEAR-OUTS -->
        <div class="card border-0 shadow-sm overflow-hidden mb-4">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0">Demanded Partner Payout Clear-Outs</h5>
                    <small class="text-muted">Partners demanding to clear out their realized balance. The system generates UPI QR codes automatically from their UPI ID.</small>
                </div>
                <span class="badge bg-primary px-3 py-2 fw-semibold">
                    <%= payouts.filter(p => p.status === 'pending').length %> Demands Pending
                </span>
            </div>
            <% if (payouts.length === 0) { %>
                <div class="p-5 text-center text-muted">No partner clear-out requests submitted yet.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-3 py-3">Partner Email</th>
                                <th class="px-3 py-3">Demanded Payout</th>
                                <th class="px-3 py-3">Partner UPI ID</th>
                                <th class="px-3 py-3">Request Date</th>
                                <th class="px-3 py-3">Status</th>
                                <th class="px-3 py-3 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% payouts.forEach(p => { %>
                                <tr>
                                    <td class="px-3 py-3">
                                        <div class="fw-bold"><%= p.partnerEmail %></div>
                                        <% if (p.notes) { %>
                                            <small class="text-muted fst-italic d-block">Note: "<%= p.notes %>"</small>
                                        <% } %>
                                    </td>
                                    <td class="px-3 py-3">
                                        <span class="fs-5 fw-bold text-success">₹<%= p.amount %></span>
                                    </td>
                                    <td class="px-3 py-3">
                                        <span class="badge bg-light text-primary border font-monospace fs-6 px-3 py-2">
                                            <%= p.partnerUpiId || 'UPI ID not set' %>
                                        </span>
                                    </td>
                                    <td class="px-3 py-3 small text-muted">
                                        <%= new Date(p.createdAt).toLocaleDateString() %> <%= new Date(p.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                    </td>
                                    <td class="px-3 py-3">
                                        <% if (p.status === 'cleared') { %>
                                            <span class="badge bg-success px-3 py-2">Cleared ✓</span>
                                            <% if (p.adminTransactionId) { %>
                                                <div class="small font-monospace text-muted mt-1">UTR: <%= p.adminTransactionId %></div>
                                            <% } %>
                                            <% if (p.adminPaymentProof) { %>
                                                <a href="<%= p.adminPaymentProof %>" target="_blank" class="small text-success d-block">View Admin Receipt</a>
                                            <% } %>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark px-3 py-2">Pending Review</span>
                                        <% } %>
                                    </td>
                                    <td class="px-3 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-1">
                                            <% if (p.status === 'pending') { %>
                                                <button class="btn btn-sm btn-success fw-bold px-3 shadow-sm btn-clear-payout" 
                                                        data-id="<%= p.id %>"
                                                        data-email="<%= p.partnerEmail %>"
                                                        data-amount="<%= p.amount %>"
                                                        data-upi="<%= p.partnerUpiId || '' %>">
                                                    Scan QR & Pay Partner →
                                                </button>
                                            <% } else { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 align-self-center">Settled</span>
                                            <% } %>
                                            <% if (p.partnerId) { %>
                                                <a href="/admin/chat?userId=<%= p.partnerId %>" class="btn btn-sm btn-outline-primary">Chat</a>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>

    <!-- TAB 2: SERVICE CATALOG MODERATION -->
    <div class="tab-pane fade" id="services-tab" role="tabpanel">
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0">All Listed Services & Moderation</h5>
                    <small class="text-muted">Super admin can remove any service listing. A custom feedback email will be dispatched to the partner.</small>
                </div>
            </div>
            <% if (services.length === 0) { %>
                <div class="p-5 text-center text-muted">No services listed in the marketplace yet.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-3 py-3">Service</th>
                                <th class="px-3 py-3">Partner</th>
                                <th class="px-3 py-3">Category</th>
                                <th class="px-3 py-3">Price</th>
                                <th class="px-3 py-3">Status</th>
                                <th class="px-3 py-3 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% services.forEach(s => { %>
                                <tr>
                                    <td class="px-3 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <% if (s.image) { %>
                                                <img src="<%= s.image %>" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;">
                                            <% } else { %>
                                                <div class="rounded bg-light border d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 50px; font-size: 0.75rem;">No Img</div>
                                            <% } %>
                                            <div>
                                                <a href="/marketplace/<%= s.id %>" target="_blank" class="fw-bold text-dark text-decoration-none">
                                                    <%= s.title %>
                                                </a>
                                                <small class="text-muted d-block" style="max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= s.description %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-3 py-3 small"><%= s.provider ? s.provider.email : 'Unknown' %></td>
                                    <td class="px-3 py-3"><span class="badge bg-light text-secondary"><%= s.category %></span></td>
                                    <td class="px-3 py-3 fw-bold text-success">₹<%= s.price %></td>
                                    <td class="px-3 py-3">
                                        <span class="badge bg-<%= s.status === 'published' ? 'success' : 'secondary' %>">
                                            <%= s.status %>
                                        </span>
                                    </td>
                                    <td class="px-3 py-3 text-end">
                                        <button class="btn btn-sm btn-outline-danger fw-medium btn-remove-service" 
                                                data-id="<%= s.id %>"
                                                data-title="<%= s.title %>"
                                                data-email="<%= s.provider ? s.provider.email : '' %>">
                                            Remove Service
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>

    <!-- TAB 3: BOOKINGS & ORDERS -->
    <div class="tab-pane fade" id="orders-tab" role="tabpanel">
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0">Master Bookings Ledger</h5>
                <small class="text-muted">Real-time tracker of all service requests, payments, and completion statuses.</small>
            </div>
            <% if (appointments.length === 0) { %>
                <div class="p-5 text-center text-muted">No bookings or orders recorded yet.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-3 py-3">Order ID / Date</th>
                                <th class="px-3 py-3">Service</th>
                                <th class="px-3 py-3">Customer</th>
                                <th class="px-3 py-3">Partner</th>
                                <th class="px-3 py-3">Amount</th>
                                <th class="px-3 py-3">Payment Proof</th>
                                <th class="px-3 py-3">Order Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% appointments.forEach(app => { %>
                                <tr>
                                    <td class="px-3 py-3">
                                        <div class="fw-bold font-monospace small">#<%= app.id.substring(0, 8) %></div>
                                        <small class="text-muted"><%= app.date %> <%= app.time %></small>
                                    </td>
                                    <td class="px-3 py-3 fw-medium"><%= app.service ? app.service.title : 'Service' %></td>
                                    <td class="px-3 py-3 small"><%= app.customer ? app.customer.email : 'Unknown' %></td>
                                    <td class="px-3 py-3 small"><%= app.partner ? app.partner.email : 'Unknown' %></td>
                                    <td class="px-3 py-3">
                                        <div class="fw-bold text-success">₹<%= app.paymentAmount || (app.service ? app.service.price : 0) %></div>
                                        <small class="text-muted" style="font-size: 0.7rem;">Platform Revenue: ₹<%= (Number(app.paymentAmount || 0) * 0.10).toFixed(2) %></small>
                                    </td>
                                    <td class="px-3 py-3">
                                        <% if (app.paymentScreenshot) { %>
                                            <a href="<%= app.paymentScreenshot %>" target="_blank" class="small text-decoration-none">
                                                📷 Proof (<%= app.paymentStatus %>)
                                            </a>
                                            <% if (app.transactionId) { %>
                                                <div class="text-muted small font-monospace"><%= app.transactionId %></div>
                                            <% } %>
                                        <% } else { %>
                                            <span class="text-muted small">None</span>
                                        <% } %>
                                    </td>
                                    <td class="px-3 py-3">
                                        <span class="badge rounded-pill bg-<%= app.status === 'pending' ? 'warning text-dark' : app.status === 'accepted' ? 'info text-dark' : app.status === 'completed' ? 'success' : 'danger' %> px-3 py-2">
                                            <%= app.status %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>

    <!-- TAB 4: USERS DIRECTORY -->
    <div class="tab-pane fade" id="users-tab" role="tabpanel">
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card border-0 shadow-sm overflow-hidden h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold mb-0">Registered Customers (<%= customers.length %>)</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-3 py-3">Email</th>
                                    <th class="px-3 py-3">Bookings</th>
                                    <th class="px-3 py-3 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% customers.forEach(c => { %>
                                    <tr>
                                        <td class="px-3 py-3">
                                            <div class="fw-bold"><%= c.email %></div>
                                            <span class="badge bg-<%= c.isVerified ? 'success-subtle text-success' : 'danger-subtle text-danger' %>" style="font-size: 0.7rem;">
                                                <%= c.isVerified ? 'Verified' : 'Unverified' %>
                                            </span>
                                        </td>
                                        <td class="px-3 py-3"><%= c.bookingsCount || 0 %></td>
                                        <td class="px-3 py-3 text-end">
                                            <a href="/admin/chat?userId=<%= c.id %>" class="btn btn-sm btn-outline-primary">Open Chat</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card border-0 shadow-sm overflow-hidden h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold mb-0">Registered Partners (<%= partners.length %>)</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-3 py-3">Email / UPI</th>
                                    <th class="px-3 py-3">Services</th>
                                    <th class="px-3 py-3 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% partners.forEach(p => { %>
                                    <tr>
                                        <td class="px-3 py-3">
                                            <div class="fw-bold"><%= p.email %></div>
                                            <small class="text-primary font-monospace"><%= p.partnerUpiId || 'No UPI ID' %></small>
                                        </td>
                                        <td class="px-3 py-3"><%= p.servicesCount || 0 %> listed</td>
                                        <td class="px-3 py-3 text-end">
                                            <a href="/admin/chat?userId=<%= p.id %>" class="btn btn-sm btn-outline-primary">Open Chat</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 1: Clear Payout with Dynamic Generated QR & Proof Upload -->
<div class="modal fade" id="clearPayoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-success text-white border-0 py-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5 fw-bold" id="clearPayoutModalTitle">Settle Partner Payout</span>
                    <span class="badge bg-white text-success fw-bold">Partner UPI QR</span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="clearPayoutForm" method="POST" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <!-- Partner & Amount Overview Card -->
                    <div class="p-3 mb-4 rounded-3 text-center" style="background: linear-gradient(135deg, #f0fdf4 0%, #f8fafc 100%); border: 1px solid #bbf7d0;">
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Respective Partner Payee Details</span>
                        <h4 class="fw-bold mb-1 text-dark" id="modalPartnerEmail"></h4>
                        <div class="d-flex justify-content-center align-items-baseline gap-2 mt-1">
                            <span class="text-muted small">Settlement Payout Amount:</span>
                            <span class="fs-3 fw-bold text-success" id="modalPayoutAmount"></span>
                        </div>
                        <div class="d-flex justify-content-center align-items-center gap-2 mt-2">
                            <span class="badge bg-primary px-3 py-2 fs-6 font-monospace" id="modalPartnerUpi"></span>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-1" id="btnCopyModalUpi">
                                📋 Copy Partner UPI
                            </button>
                        </div>
                    </div>

                    <div class="row g-4 align-items-start">
                        <!-- Left: Dynamic UPI QR Code (Generated Automatically by System) -->
                        <div class="col-md-6 text-center border-end-md">
                            <!-- Dynamic Pre-filled QR Code Container -->
                            <div id="dynamicQrContainer" class="p-3 bg-light rounded-3 border d-inline-block shadow-sm w-100">
                                <div class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 mb-2 fw-semibold">
                                    ✓ Auto Generated Payout QR: <span id="dynamicQrAmountBadge">₹0</span>
                                </div>
                                <div class="my-2 d-flex justify-content-center">
                                    <img id="modalGeneratedQrImg" src="" alt="Dynamic Partner UPI QR Code" class="img-fluid rounded border shadow-sm p-2 bg-white" style="width: 220px; height: 220px; object-fit: contain;">
                                </div>
                                <small class="d-block text-muted mt-2">
                                    Scan with <strong>GPay, PhonePe, Paytm, or BHIM</strong>.<br>
                                    Exact payout amount is pre-filled automatically by CampusConnect.
                                </small>
                                <div class="mt-2">
                                    <a id="modalUpiDeepLink" href="#" class="btn btn-sm btn-light border text-primary fw-medium small">
                                        📲 Pay via UPI App (Device)
                                    </a>
                                </div>
                            </div>

                            <!-- Missing UPI Alert -->
                            <div id="modalMissingUpiAlert" class="alert alert-warning border-0 small mt-2" style="display: none;">
                                ⚠️ Partner has not registered a UPI ID yet. Use the Chat button to ask them for their UPI ID.
                            </div>
                        </div>

                        <!-- Right: Payment Proof & Confirmation -->
                        <div class="col-md-6">
                            <h6 class="fw-bold text-dark mb-3">Confirm Payment & Proof</h6>

                            <div class="mb-3">
                                <label for="paymentProof" class="form-label text-muted fw-semibold small">Upload Screenshot of Payment Made (Receipt) *</label>
                                <input type="file" class="form-control" name="paymentProof" accept="image/*" required>
                                <div class="form-text small">Delivered to the partner as official proof of payment.</div>
                            </div>
                            <div class="p-3 bg-light rounded-3 border small text-muted">
                                <strong>System Notice:</strong> Once submitted, the payout status becomes <span class="badge bg-success">Cleared</span> and an instant email receipt is dispatched to the partner.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold px-4 shadow-sm">✓ Confirm Payout Settled</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 2: Remove Service with Custom Feedback Email -->
<div class="modal fade" id="removeServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-danger text-white border-0 py-3">
                <h5 class="modal-title fw-bold">Remove Service Listing & Notify Partner</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="removeServiceForm" method="POST">
                <div class="modal-body p-4">
                    <div class="alert alert-warning border-0 small">
                        <strong>Action Notice:</strong> This service listing will be permanently unpublished from the marketplace. An official feedback email will be sent automatically to the partner.
                    </div>

                    <div class="mb-3">
                        <span class="text-muted small">Service Title:</span>
                        <h6 class="fw-bold" id="removeServiceTitle"></h6>
                        <span class="text-muted small">Partner:</span>
                        <div class="small fw-semibold text-dark" id="removeServicePartner"></div>
                    </div>

                    <div class="mb-3">
                        <label for="feedback" class="form-label text-muted fw-bold small">Reason & Constructive Feedback (Emailed to Partner) *</label>
                        <textarea class="form-control" name="feedback" rows="4" required placeholder="Explain why this listing is being removed (e.g. violation of terms, prohibited offering, incorrect pricing, or quality feedback)..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-bold px-4">Remove Service & Send Feedback Email</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 3: Instant Quick Pay QR Generator for Partner Directory -->
<div class="modal fade" id="quickQrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5 fw-bold">⚡ Dynamic Partner UPI QR</span>
                    <span class="badge bg-success text-white fw-bold">Live Amount</span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <h5 class="fw-bold text-dark mb-1" id="quickQrPartnerEmail"></h5>
                <div class="d-flex justify-content-center align-items-center gap-2 mb-3">
                    <span class="badge bg-primary px-3 py-2 fs-6 font-monospace" id="quickQrPartnerUpi"></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-1" id="btnCopyQuickUpi">
                        📋 Copy UPI
                    </button>
                </div>

                <div class="mb-3 text-start">
                    <label class="form-label small text-muted fw-bold">Payout Amount to Pre-fill (₹):</label>
                    <div class="input-group">
                        <span class="input-group-text fw-bold">₹</span>
                        <input type="number" id="quickQrAmountInput" class="form-control fw-bold fs-5 text-success" step="1" min="1">
                        <button class="btn btn-outline-secondary" type="button" id="btnRecalculateQr">Update QR</button>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 border d-inline-block shadow-sm my-2">
                    <img id="quickQrImg" src="" alt="Generated UPI QR Code" class="img-fluid rounded border shadow-sm p-2 bg-white" style="width: 220px; height: 220px; object-fit: contain;">
                    <div class="mt-2 text-muted small">
                        Scan with <strong>GPay / PhonePe / Paytm / BHIM</strong><br>
                        Amount <strong class="text-success" id="quickQrAmountDisplay"></strong> pre-filled automatically!
                    </div>
                    <div class="mt-2">
                        <a id="quickQrDeepLink" href="#" class="btn btn-sm btn-outline-primary">📲 Open in UPI App</a>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 p-3 pt-0 justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Preserve tab in URL hash
    const hash = window.location.hash;
    if (hash) {
        const triggerEl = document.querySelector(`button[data-bs-target="${hash}"]`);
        if (triggerEl) {
            bootstrap.Tab.getOrCreateInstance(triggerEl).show();
        }
    }

    // Helper: generate UPI pay URL
    function buildUpiUrl(upi, name, amount) {
        const cleanUpi = (upi || '').trim();
        const cleanName = (name || 'Partner').trim();
        const cleanAmount = (amount || '0').toString().trim();
        return `upi://pay?pa=${encodeURIComponent(cleanUpi)}&pn=${encodeURIComponent(cleanName)}&am=${encodeURIComponent(cleanAmount)}&cu=INR&tn=${encodeURIComponent('CampusConnect Payout')}`;
    }

    // Helper: generate QR image URL from payload
    function buildQrImgUrl(upiUrl) {
        return `https://api.qrserver.com/v1/create-qr-code/?size=240x240&margin=8&data=${encodeURIComponent(upiUrl)}`;
    }

    let currentModalUpi = '';
    let currentQuickUpi = '';
    let currentQuickEmail = '';

    // Clear payout modal trigger
    document.querySelectorAll('.btn-clear-payout').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const email = btn.getAttribute('data-email');
            const amount = btn.getAttribute('data-amount');
            const upi = btn.getAttribute('data-upi');

            currentModalUpi = upi || '';

            document.getElementById('clearPayoutForm').action = `/admin/payouts/${id}/clear`;
            document.getElementById('modalPartnerEmail').innerText = email;
            document.getElementById('modalPayoutAmount').innerText = '₹' + amount;
            document.getElementById('modalPartnerUpi').innerText = upi || 'UPI Not Configured';
            document.getElementById('dynamicQrAmountBadge').innerText = '₹' + amount;

            const dynamicContainer = document.getElementById('dynamicQrContainer');
            const missingAlert = document.getElementById('modalMissingUpiAlert');

            if (upi) {
                missingAlert.style.display = 'none';
                dynamicContainer.style.display = 'inline-block';
                const upiUrl = buildUpiUrl(upi, email, amount);
                const qrUrl = buildQrImgUrl(upiUrl);

                document.getElementById('modalGeneratedQrImg').src = qrUrl;
                document.getElementById('modalUpiDeepLink').href = upiUrl;
            } else {
                missingAlert.style.display = 'block';
                dynamicContainer.style.display = 'none';
            }

            new bootstrap.Modal(document.getElementById('clearPayoutModal')).show();
        });
    });

    // Copy UPI buttons
    document.getElementById('btnCopyModalUpi').addEventListener('click', () => {
        if (!currentModalUpi) return;
        navigator.clipboard.writeText(currentModalUpi);
        const btn = document.getElementById('btnCopyModalUpi');
        const oldText = btn.innerText;
        btn.innerText = '✓ Copied!';
        setTimeout(() => { btn.innerText = oldText; }, 2000);
    });

    document.getElementById('btnCopyQuickUpi').addEventListener('click', () => {
        if (!currentQuickUpi) return;
        navigator.clipboard.writeText(currentQuickUpi);
        const btn = document.getElementById('btnCopyQuickUpi');
        const oldText = btn.innerText;
        btn.innerText = '✓ Copied!';
        setTimeout(() => { btn.innerText = oldText; }, 2000);
    });

    // Quick QR Generator from Partner Directory
    function renderQuickQr() {
        const amount = document.getElementById('quickQrAmountInput').value || '0';
        document.getElementById('quickQrAmountDisplay').innerText = '₹' + amount;
        const upiUrl = buildUpiUrl(currentQuickUpi, currentQuickEmail, amount);
        const qrUrl = buildQrImgUrl(upiUrl);
        document.getElementById('quickQrImg').src = qrUrl;
        document.getElementById('quickQrDeepLink').href = upiUrl;
    }

    document.querySelectorAll('.btn-quick-qr').forEach(btn => {
        btn.addEventListener('click', () => {
            currentQuickEmail = btn.getAttribute('data-email');
            currentQuickUpi = btn.getAttribute('data-upi');
            const balance = btn.getAttribute('data-balance') || '0';

            document.getElementById('quickQrPartnerEmail').innerText = currentQuickEmail;
            document.getElementById('quickQrPartnerUpi').innerText = currentQuickUpi;
            document.getElementById('quickQrAmountInput').value = Number(balance) > 0 ? balance : 100;

            renderQuickQr();
            new bootstrap.Modal(document.getElementById('quickQrModal')).show();
        });
    });

    document.getElementById('btnRecalculateQr').addEventListener('click', renderQuickQr);
    document.getElementById('quickQrAmountInput').addEventListener('input', renderQuickQr);

    // Remove service modal trigger
    document.querySelectorAll('.btn-remove-service').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const title = btn.getAttribute('data-title');
            const email = btn.getAttribute('data-email');

            document.getElementById('removeServiceForm').action = `/admin/services/${id}/remove`;
            document.getElementById('removeServiceTitle').innerText = title;
            document.getElementById('removeServicePartner').innerText = email;
            new bootstrap.Modal(document.getElementById('removeServiceModal')).show();
        });
    });
});
</script>
