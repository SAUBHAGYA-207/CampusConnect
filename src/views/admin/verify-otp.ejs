<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-6 col-lg-5">
        <div class="mb-3">
            <a href="/admin/login" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-3 py-2 fw-medium" style="border-radius: 8px;">
                ← Back to Login
            </a>
        </div>
        <div class="card p-4 p-md-5 border-0 shadow-lg" style="border-radius: 20px; background: var(--espresso); color: #f8fafc; border: 1px solid rgba(235, 218, 208, 0.2) !important;">
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 72px; height: 72px; background: rgba(150, 61, 36, 0.25); border: 2px solid var(--cognac);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-shield-check" style="color: var(--cognac);" viewBox="0 0 16 16">
                        <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.546-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.159 7.159 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
                        <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                    </svg>
                </div>
                <div class="badge px-3 py-1 mb-2 fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 0.7rem; background-color: var(--cognac); color: #fff;">
                    TWO-FACTOR AUTHENTICATION
                </div>
                <h3 class="fw-bold mb-1 text-white">Verify Admin Identity</h3>
                <p class="text-white-50 small mb-0">
                    We sent a 6-digit security code to your authorized email:<br>
                    <strong class="text-white"><%= userEmail %></strong>
                </p>
            </div>

            <% if (error) { %>
                <div class="alert d-flex align-items-center gap-2 py-2 px-3 small rounded-3 mb-3 text-start" 
                     style="background: rgba(239, 68, 68, 0.18); border: 1px solid rgba(248, 113, 113, 0.45); color: #FCA5A5;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-triangle-fill flex-shrink-0" style="color: #F87171;" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                    </svg>
                    <span class="fw-semibold"><%= error %></span>
                </div>
            <% } %>

            <% if (typeof resent !== 'undefined' && resent) { %>
                <div class="alert d-flex align-items-center gap-2 py-2 px-3 small rounded-3 mb-3 text-start" 
                     style="background: rgba(16, 185, 129, 0.18); border: 1px solid rgba(52, 211, 153, 0.45); color: #6EE7B7;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill flex-shrink-0" style="color: #34D399;" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                    </svg>
                    <span class="fw-semibold">A new OTP code has been dispatched to your email.</span>
                </div>
            <% } else if (typeof sent !== 'undefined' && sent) { %>
                <div class="alert d-flex align-items-center gap-2 py-2 px-3 small rounded-3 mb-3 text-start" 
                     style="background: rgba(59, 130, 246, 0.18); border: 1px solid rgba(96, 165, 250, 0.45); color: #93C5FD;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-info-circle-fill flex-shrink-0" style="color: #60A5FA;" viewBox="0 0 16 16">
                        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                    </svg>
                    <span class="fw-medium">Security OTP code dispatched to your email inbox.</span>
                </div>
            <% } %>

            <form action="/admin/verify-otp" method="POST">
                <div class="mb-4">
                    <label for="otp" class="form-label text-white-50 fw-semibold small text-center d-block">6-Digit Verification Code</label>
                    <input type="text" class="form-control form-control-lg text-center fw-bold text-white border-secondary" id="otp" name="otp" placeholder="••••••" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" style="letter-spacing: 8px; font-size: 1.8rem; background-color: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15);" required autofocus>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow">
                    Verify & Enter Console
                </button>
            </form>

            <div class="mt-4 pt-3 border-top text-center" style="border-color: rgba(255,255,255,0.1) !important;">
                <p class="text-white-50 small mb-2">Didn't receive the email code?</p>
                <a href="/admin/resend-otp" class="btn btn-sm btn-outline-light px-3 py-1 fw-medium" style="border-radius: 8px;">
                    ↻ Resend Code
                </a>
            </div>
        </div>
    </div>
</div>
