<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-6 col-lg-4">
        <div class="mb-3">
            <a href="/" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-3 py-2 fw-medium" style="border-radius: 8px;" onclick="if (window.history.length > 1) { history.back(); return false; }">
                ← Back
            </a>
        </div>
        <div class="card p-4 p-md-5 border-0 shadow-lg" style="border-radius: 20px; background: var(--espresso); color: #f8fafc; border: 1px solid rgba(235, 218, 208, 0.2) !important;">
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 72px; height: 72px; background: rgba(150, 61, 36, 0.25); border: 2px solid var(--cognac);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-shield-lock-fill" style="color: var(--cognac);" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm0 5a1.5 1.5 0 0 1 1.5 1.5v.5h.5a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1h.5v-.5A1.5 1.5 0 0 1 8 5zm.5 2v-.5a.5.5 0 0 0-1 0V7h1z"/>
                    </svg>
                </div>
                <div class="badge px-3 py-1 mb-2 fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 0.7rem; background-color: var(--cognac); color: #fff;">
                    RESTRICTED ACCESS
                </div>
                <h3 class="fw-bold mb-1 text-white">Super Admin Portal</h3>
                <p class="text-white-50 small mb-0">CampusConnect Executive Control & Revenue Command</p>
            </div>

            <% if (error) { %>
                <div class="alert d-flex align-items-center gap-2 py-2 px-3 small rounded-3 mb-4" 
                     style="background: rgba(239, 68, 68, 0.18); border: 1px solid rgba(248, 113, 113, 0.45); color: #FCA5A5;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-shield-x flex-shrink-0" style="color: #F87171;" viewBox="0 0 16 16">
                        <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.546-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.159 7.159 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
                        <path d="M6.146 5.146a.5.5 0 0 1 .708 0L8 6.293l1.146-1.147a.5.5 0 1 1 .708.708L8.707 7l1.147 1.146a.5.5 0 0 1-.708.708L8 7.707 6.854 8.854a.5.5 0 1 1-.708-.708L7.293 7 6.146 5.854a.5.5 0 0 1 0-.708z"/>
                    </svg>
                    <span class="fw-semibold" style="line-height: 1.4;"><%= error %></span>
                </div>
            <% } %>

            <form action="/admin/login" method="POST">
                <div class="mb-3">
                    <label for="email" class="form-label text-white-50 fw-semibold small">Super Admin Email</label>
                    <input type="email" class="form-control form-control-lg text-white border-secondary" id="email" name="email" placeholder="name@domain.com" style="background-color: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15);" autofocus required>
                </div>
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label for="password" class="form-label text-white-50 fw-semibold small mb-0">Master Secret Key / Password</label>
                        <a href="/auth/forgot-password" class="small text-decoration-none" style="color: var(--amber); font-size: 0.8rem;">Forgot password?</a>
                    </div>
                    <input type="password" class="form-control form-control-lg text-white border-secondary" id="password" name="password" placeholder="••••••••" style="background-color: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15);" required>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow">
                    Authenticate Super Admin
                </button>
            </form>

            <div class="text-center mt-3">
                <small class="text-white-50">Need to create an admin account? <a href="/admin/register" class="fw-semibold text-decoration-none" style="color: var(--amber);">Register as Admin</a></small>
            </div>

            <div class="mt-4 pt-3 border-top text-center" style="border-color: rgba(255,255,255,0.1) !important;">
                <small class="text-white-50">
                    🔒 Authorized administrative access only. Session activity is audited.
                </small>
                <div class="mt-3">
                    <a href="/" class="text-white-50 small text-decoration-none" onclick="if (window.history.length > 1) { history.back(); return false; }">← Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
